# This is Git's per-user configuration file.
[user]
	name = Andrii Khymera

[include]
	path = ~/.config/git/config.local

[alias]
	aacp = "!f() { git add . && git commit -m \"$1\" && git push; }; f"

[push]
	autoSetupRemote = true

[init]
	defaultBranch = main

[core]
    excludesfile = ~/.config/git/ignore
